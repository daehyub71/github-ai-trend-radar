#!/bin/sh
# 커밋 전 게이트: ruff -> mypy -> pytest -> size_guard --staged
# 클론마다 한 번:  git config core.hooksPath scripts/hooks
set -e
cd "$(git rev-parse --show-toplevel)"
PY=.venv/bin/python
[ -x "$PY" ] || PY=.venv/Scripts/python.exe
"$PY" -m ruff check .
"$PY" -m mypy radar tests scripts
"$PY" -m pytest -q
"$PY" scripts/size_guard.py --staged
